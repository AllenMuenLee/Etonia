# Copy to supabase/.env.local (ignored by Git). Never ship this in the app.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Paste compact JSON based on model-config.example.json, with real model IDs
# and verified per-model prices, all on one line. No fallback model IDs are used.
AI_MODEL_CONFIG=
# Optional JSON overlay for adding or overriding models without replacing the catalog.
AI_MODEL_CONFIG_OVERRIDES=
# Server-only notation/animation alias. Blank or absent defaults to luna.
AI_NOTATION_MODEL=luna
# Optional: Study Desk embedding prices, e.g. {"imageMicro":120}. Blank uses defaults.
AI_EMBED_CONFIG=
# Base64-encoded 32 random bytes. Keep this stable and backed up separately.
PURCHASE_TOKEN_ENCRYPTION_KEY=

APPLE_ENVIRONMENT=Production
APPLE_BUNDLE_ID=com.etonia.app
APPLE_APP_ID=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
# PKCS8 .p8 contents; literal \n is accepted between PEM lines.
APPLE_PRIVATE_KEY=
# JSON array of base64 DER Apple root certificates from https://www.apple.com/certificateauthority/
APPLE_ROOT_CERTS_BASE64=
# Sign in with Apple key (Certificates, Identifiers & Profiles > Keys), used to
# revoke a deleted account's Apple tokens. Without it, deletion still works.
APPLE_TEAM_ID=
APPLE_SIGN_IN_KEY_ID=
APPLE_SIGN_IN_PRIVATE_KEY=

GOOGLE_PACKAGE_NAME=com.etonia.app
GOOGLE_OAUTH_CLIENT_SECRET=
# Service account JSON, on one line, authorized for this app in Google Play.
GOOGLE_SERVICE_ACCOUNT_JSON=
ALLOW_GOOGLE_TEST_PURCHASES=false
# Exact audience and service account email configured on your Pub/Sub push subscription.
GOOGLE_PUSH_AUDIENCE=https://YOUR_PROJECT_REF.supabase.co/functions/v1/store-events
GOOGLE_PUSH_SERVICE_ACCOUNT_EMAIL=
